{
  "log": {
    "loglevel": "warning"
  },
  "api": {
    "tag": "api",
    "listen": "127.0.0.1:10085",
    "services": [
      "HandlerService",
      "RoutingService",
      "StatsService",
      "ReflectionService"
    ]
  },
  "routing": {
    "domainStrategy": "IPIfNonMatch"
  },
  "stats": {},
  "policy": {
    "levels": {
      "0": {
        "statsUserUplink": true,
        "statsUserDownlink": true
      }
    }
  },
  "outbounds": [
    {
      "tag": "direct",
      "protocol": "freedom"
    }
  ]
}
